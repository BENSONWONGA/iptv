registerTemplate("stock.ReportMRPLines", `/stock/static/src/client_actions/stock_traceability_report_backend.xml`, `<t t-name="stock.ReportMRPLines" xml:space="preserve">
        <t t-foreach="lines" t-as="line" t-key="line.id">
            <t t-if="!line.isFolded and line.line_type=='child' and line.lines.length" t-call="stock.ReportMRPLines" lines="line.lines"/>
            <tr t-att-class="line.model_name === 'stock.move.line' ? 'o_stock_reports_level0' : 'o_stock_reports_default_style'">
                <t t-foreach="line.columns" t-as="col" t-key="col.name">
                    <td t-att-class="line.unfoldable ? 'o_stock_reports_unfoldable' : ''">
                        <t t-if="col_first">
                            <span t-attf-style="margin-left: {{this.getLevel(line)}}px; "/>
                            <t t-if="line.line_type == 'child' and line.unfoldable">
                                <span class="o_stock_reports_unfoldable o_stock_reports_caret_icon" t-on-click="() =&gt; this.toggleLine(line, 'child')">
                                    <i class="" data-icon="subdirectory_arrow_left" t-att-class="line.isFolded ? 'oi oi-fw' : ''" role="img" aria-label="Expand" t-att-title="line.isFolded ? 'Expand' : 'Fold'"/>
                                </span>
                            </t>
                            <t t-elif="line.line_type == 'parent' and line.unfoldable">
                                <span class="o_stock_reports_unfoldable o_stock_reports_caret_icon" t-on-click="() =&gt; this.toggleLine(line, 'parent')">
                                    <i class="oi oi-fw" t-att-data-icon="line.isFolded ? 'arrow_right' : 'arrow_drop_down'" role="img" aria-label="Unfold" t-att-title="line.isFolded ? 'Unfold' : 'Fold'"/>
                                </span>
                            </t>
                        </t>

                        <span t-if="col.value and line.reference === col.value" t-att-class="!line.unfoldable and line.line_type == 'parent' ? 'o_stock_reports_nofoldable' : ''">
                            <a class="o_stock_reports_web_action" href="#" t-on-click.prevent="() =&gt; this.onClickBoundLink(line)" t-out="col.value"/>
                        </span>
                        <span t-elif="col.value and ((line.picking_type_code == 'incoming' and line.source_name === col.value) or (line.picking_type_code == 'outgoing' and line.destination_name === col.value))">
                            <a class="o_stock_report_partner_action" href="#" t-on-click.prevent="() =&gt; this.onClickPartner(line)" t-out="col.value"/>
                        </span>
                        <span t-elif="col.value and (line.source_name === col.value or (line.destination_name === col.value and !line.highlight_destination))">
                            <span class="o_stock_reports_dim" t-out="col.value"/>
                        </span>
                        <span t-elif="col.value and line.lot_name === col.value">
                            <a class="o_stock_report_lot_action" href="#" t-on-click.prevent="() =&gt; this.onClickOpenLot(line)" t-out="col.value"/>
                        </span>
                        <t t-elif="col.value" t-out="col.value"/>
                    </td>
                </t>
            </tr>

            <t t-if="!line.isFolded and line.line_type=='parent' and line.lines.length" t-call="stock.ReportMRPLines" lines="line.lines"/>
        </t>
    </t>

`);
