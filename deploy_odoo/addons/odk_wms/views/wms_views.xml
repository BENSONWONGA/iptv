        <field name="name">加工领料单</field>
        <field name="res_model">odk.wms.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doc_type', '=', 'out_mfg')]</field>
        <field name="context">{'default_doc_type': 'out_mfg'}</field>
        <field name="search_view_id" ref="view_odk_wms_order_search"/>
