<odoo>
    <!-- BOM 表单增加 ECO 智能按钮 -->
    <record id="mrp_bom_form_view_inherit_plm" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.plm</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_ecos" type="object" class="oe_stat_button" icon="fa-history">
                    <field name="eco_count" widget="statinfo" string="工程变更"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
