<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_odk_dispatch" model="ir.sequence">
            <field name="name">派工单</field>
            <field name="code">odk.dispatch</field>
            <field name="prefix">PG-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_odk_dispatch_report" model="ir.sequence">
            <field name="name">派工日报</field>
            <field name="code">odk.dispatch.report</field>
            <field name="prefix">DR-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_odk_barcode" model="ir.sequence">
            <field name="name">指令部件条码</field>
            <field name="code">odk.dispatch.barcode</field>
            <field name="prefix">BC-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_odk_barcode_merge" model="ir.sequence">
            <field name="name">指令部件套码</field>
            <field name="code">odk.dispatch.barcode.merge</field>
            <field name="prefix">HB-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
