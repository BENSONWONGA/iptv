                        <t t-if="skip_row" t-set="skip_row" t-value="skip_row - 1"/>
                        <t t-if="!skip_row">
                            <t t-if="this.mergesLinesData[line_index]" t-set="skip_row" t-value="this.mergesLinesData[line_index]['rowcount']"/>
                            <td t-attf-rowspan="#{skip_row &gt; 0 and skip_row}"/>
