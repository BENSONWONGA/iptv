                                <button class="btn btn-sm border-0" data-bs-toggle="collapse" t-attf-data-bs-target=".collapseGroup_#{line.product.id}" aria-expanded="true" t-attf-aria-controls=".collapseGroup_#{line.product.id}">
                                    <i class="icon oi"/>
