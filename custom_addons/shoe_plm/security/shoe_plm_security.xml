<odoo>
    <data noupdate="0">
        <record model="res.groups.privilege" id="res_groups_privilege_plm">
            <field name="name">研发管理</field>
            <field name="category_id" ref="base.module_category_supply_chain"/>
        </record>

        <record id="group_plm_user" model="res.groups">
            <field name="name">研发工程师</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="res_groups_privilege_plm"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_plm_manager" model="res.groups">
            <field name="name">研发经理</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="res_groups_privilege_plm"/>
            <field name="implied_ids" eval="[(4, ref('group_plm_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
