        <field name="name">指令盘点调整单</field>
        <field name="res_model">odk.wms.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('scan_type', '=', 'instruction')]</field>
        <field name="context">{'default_scan_type': 'instruction'}</field>
