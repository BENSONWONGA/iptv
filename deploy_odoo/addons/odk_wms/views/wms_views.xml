    <!-- 查询报表类动作 -->
    <record id="action_wms_stock_query" model="ir.actions.act_window">
        <field name="name">材料库存查询</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list</field>
        <field name="domain">[('is_storable', '=', True)]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_odk_wms_stock_list')})]"/>
        <field name="search_view_id" ref="view_odk_wms_stock_search"/>
    </record>
    <record id="action_wms_purchase" model="ir.actions.act_window">
        <field name="name">材料采购单</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_wms_iqc" model="ir.actions.act_window">
        <field name="name">暂收待检单</field>
        <field name="res_model">odk.quality.check</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('check_type', '=', 'iqc')]</field>
        <field name="context">{'default_check_type': 'iqc'}</field>
    </record>
    <record id="action_wms_iqc_report" model="ir.actions.act_window">
        <field name="name">待检记录报表</field>
        <field name="res_model">odk.quality.check</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('check_type', '=', 'iqc')]</field>
    </record>

    <!-- ================= 菜单：独立「仓库管理」应用 ================= -->
    <menuitem id="menu_odk_wms_root" name="仓库管理" sequence="46"/>

    <menuitem id="menu_wms_in" name="入库管理" parent="menu_odk_wms_root" sequence="10"/>
