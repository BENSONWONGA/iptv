                                </a>
                                <button t-elif="line.replenishment_filled or this.AvailableOnHandTotalQty[line.product.id] &gt; 0" class="btn btn-sm btn-secondary" name="reserve_link" t-on-click="() =&gt; this._reserve(line.move_out.id)">
