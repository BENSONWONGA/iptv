        <field name="res_model">odk.wms.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doc_type', '=', 'in_purchase')]</field>
        <field name="context">{'default_doc_type': 'in_purchase'}</field>
        <field name="search_view_id" ref="view_odk_wms_order_search"/>
    </record>
    <record id="action_wms_in_customer" model="ir.actions.act_window">
        <field name="name">客供料入库</field>
        <field name="res_model">odk.wms.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('doc_type', '=', 'in_customer')]</field>
        <field name="context">{'default_doc_type': 'in_customer'}</field>
        <field name="search_view_id" ref="view_odk_wms_order_search"/>
