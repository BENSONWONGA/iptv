<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_odk_subcontract_order" model="ir.sequence">
            <field name="name">委外加工单</field>
            <field name="code">odk.subcontract.order</field>
            <field name="prefix">EO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_odk_subcontract_quote" model="ir.sequence">
            <field name="name">制程工艺报价</field>
            <field name="code">odk.subcontract.quote</field>
            <field name="prefix">GYB-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
