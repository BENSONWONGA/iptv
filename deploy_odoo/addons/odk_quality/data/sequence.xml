<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_odk_quality_check" model="ir.sequence">
            <field name="name">质检单</field>
            <field name="code">odk.quality.check</field>
            <field name="prefix">QC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_odk_quality_alert" model="ir.sequence">
            <field name="name">质量异常单</field>
            <field name="code">odk.quality.alert</field>
            <field name="prefix">QA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
